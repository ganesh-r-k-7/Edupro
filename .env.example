# EduPro Environment Configuration
# Copy this file to .env and customize for your environment
# DO NOT commit .env files with real credentials

# ─── Environment ──────────────────────────────────────────────────────────────
# Options: development, staging, production
ENVIRONMENT=development

# ─── API Server ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ─── Authentication ──────────────────────────────────────────────────────────
# Enable API key authentication (required for production)
AUTH_ENABLED=false
# Comma-separated list of valid API keys (generate secure random keys for production)
API_KEYS=
# Header name for API key
API_KEY_HEADER=X-API-Key

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Enable rate limiting (required for production)
RATE_LIMIT_ENABLED=false
# Maximum requests per window
RATE_LIMIT_REQUESTS=100
# Rate limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# ─── CORS ────────────────────────────────────────────────────────────────────
# Enable CORS middleware
CORS_ENABLED=true
# Comma-separated allowed origins (use explicit origins for production, not '*')
CORS_ORIGINS=*
# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=false
# Allowed HTTP methods
CORS_ALLOW_METHODS=GET,POST,OPTIONS
# Allowed headers
CORS_ALLOW_HEADERS=*

# ─── Trusted Hosts ───────────────────────────────────────────────────────────
# Enable trusted host middleware (required for production)
TRUSTED_HOSTS_ENABLED=false
# Comma-separated allowed hostnames
TRUSTED_HOSTS=localhost,127.0.0.1

# ─── Request Limits ──────────────────────────────────────────────────────────
# Maximum request body size in MB
MAX_REQUEST_SIZE_MB=10

# ─── Paths ───────────────────────────────────────────────────────────────────
# Data directory (can be overridden for Docker mounts)
DATA_DIR=data
# Models directory
MODELS_DIR=models
# Model registry directory
REGISTRY_DIR=models/registry

# ─── Logging ─────────────────────────────────────────────────────────────────
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log format: json (production) or text (development)
LOG_FORMAT=text
# Log request timing information
LOG_REQUEST_TIMING=true

# ─── Health Checks ───────────────────────────────────────────────────────────
# Include detailed checks in readiness endpoint
HEALTH_CHECK_DETAILED=true